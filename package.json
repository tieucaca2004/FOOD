{
  "name": "tong-dai-zalo-marketplace",
  "version": "1.0.0",
  "description": "Tổng Đài — Zalo OA marketplace platform. platform/ is the marketplace layer (discovery, merchant registry/router, AI concierge); src/ is the A Tiểu merchant module it routes into, unchanged and independently runnable.",
  "type": "module",
  "main": "platform/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "platform:start": "node platform/server.js",
    "platform:dev": "node --watch platform/server.js",
    "platform:migrate": "node platform/scripts/migrate.js",
    "platform:seed": "node platform/scripts/seed.js",
    "platform:seed:demo": "node platform/scripts/seed-demo.js",
    "platform:seed:atieu": "node platform/scripts/seed-atieu.js",
    "platform:dispatch": "node platform/scripts/dispatch.js",
    "platform:menu": "node platform/scripts/menu.js",
    "knowledge:check": "node platform/scripts/knowledge.js check",
    "knowledge:init": "node platform/scripts/knowledge.js init",
    "knowledge:collect": "node tools/knowledge-collector/cli.js",
    "test:collector": "node --test tools/knowledge-collector/test/*.test.js",
    "platform:aliases": "node platform/scripts/aliases.js",
    "platform:telegram:webhook": "node platform/scripts/setup-telegram-webhook.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js test/e2e/*.test.js",
    "test:platform": "node --test platform/test/unit/*.test.js platform/test/integration/*.test.js platform/test/e2e/*.test.js",
    "test:all": "npm test && npm run test:platform && npm run test:collector",
    "test:gpt-live": "node --test platform/test/live/gptLive.test.js",
    "test:gpt-founder-live": "node --test platform/test/live/gptFounderAliasLive.test.js",
    "test:search-live": "node --test platform/test/live/searchLive.test.js",
    "bench:search": "node platform/test/bench/searchBenchmark.js",
    "test:image-live": "node --test platform/test/live/imageUnderstandingLive.test.js",
    "test:claude-cli-live": "node --test platform/test/live/claudeCliLive.test.js",
    "test:deepseek-live": "node --test platform/test/live/deepseekLive.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
