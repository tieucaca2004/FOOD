# Zalo OA credentials — from https://oa.zalo.me app dashboard
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_APP_SECRET=

# Server
PORT=3900
WEBHOOK_PATH=/zalo/webhook

# Intent classifier
MIN_CONFIDENCE=0.60

# Optional: Claude API key to let the bot phrase replies in natural language.
# The model is only ever given the seed data below as context, so it lists
# real entries — it is never asked to invent restaurants. If unset, the bot
# falls back to a deterministic template reply built directly from the seed.
ANTHROPIC_API_KEY=

# SQLite database file path
DB_PATH=./data/support.db
