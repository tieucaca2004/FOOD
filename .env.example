# === Zalo OA ===
# From https://oa.zalo.me app dashboard.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
ZALO_SEND_RETRIES=3
ZALO_SEND_TIMEOUT_MS=8000

# Webhook route path (must match what you register on oa.zalo.me, behind your reverse proxy)
WEBHOOK_PATH=/zalo/webhook

# Best-effort webhook signature check — see src/channel/zalo/verifySignature.js.
# Keep false until you've confirmed the real header/algorithm against your OA app.
ENABLE_ZALO_SIGNATURE_CHECK=false

# === Server ===
PORT=3900
NODE_ENV=production

# === AI provider (optional) ===
# "null" (default): pure rule-based NLP, no LLM calls, no API key needed.
# "anthropic": adds Claude as a fallback for messages the rule engine can't
# classify, and to rephrase replies — see src/ai/AIProvider.js for the hard
# boundary (AI never decides price/total/state).
AI_PROVIDER=null
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Intent engine ===
MIN_CONFIDENCE=0.60

# === Persistence ===
SQLITE_PATH=./data/atieu.db

# === Notifications ===
# If unset, order-confirmed notifications are logged only (never faked as sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Business rules ===
ORDER_CODE_PREFIX=AT
MAX_ITEM_QUANTITY=50

# === Security ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

LOG_LEVEL=info
