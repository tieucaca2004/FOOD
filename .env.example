# === Zalo OA ===
# From https://oa.zalo.me app dashboard.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
ZALO_SEND_RETRIES=3
ZALO_SEND_TIMEOUT_MS=8000

# Webhook route path (must match what you register on oa.zalo.me, behind your reverse proxy)
WEBHOOK_PATH=/zalo/webhook

# Best-effort webhook signature check — see src/channel/zalo/verifySignature.js.
# Keep false until you've confirmed the real header/algorithm against your OA app.
ENABLE_ZALO_SIGNATURE_CHECK=false

# === Server ===
PORT=3900
NODE_ENV=production

# === AI provider (optional) ===
# "null" (default): pure rule-based NLP, no LLM calls, no API key needed.
# "anthropic": adds Claude as a fallback for messages the rule engine can't
# classify, and to rephrase replies — see src/ai/AIProvider.js for the hard
# boundary (AI never decides price/total/state).
AI_PROVIDER=null
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Intent engine ===
MIN_CONFIDENCE=0.60

# === Persistence ===
SQLITE_PATH=./data/atieu.db

# === Notifications ===
# If unset, order-confirmed notifications are logged only (never faked as sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Business rules ===
ORDER_CODE_PREFIX=AT
MAX_ITEM_QUANTITY=50

# === Security ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

LOG_LEVEL=info

# =========================================================================
# PLATFORM (Tổng Đài marketplace layer) — see platform/README.md.
# Fully separate config from everything above; the A Tiểu module (this
# file's other sections) runs standalone and unaware of these.
# =========================================================================

# Tổng Đài's OWN Zalo OA — a different OA account than any merchant's.
PLATFORM_ZALO_OA_ACCESS_TOKEN=
PLATFORM_ZALO_OA_SECRET_KEY=
PLATFORM_ZALO_SEND_RETRIES=3
PLATFORM_ZALO_SEND_TIMEOUT_MS=8000
# Signature check on the platform Zalo webhook. On unless set to exactly
# "false"; with it on, PLATFORM_ZALO_OA_SECRET_KEY must be set or every Zalo
# request is rejected. Turning it off lets anyone who can reach the webhook
# post messages as any Zalo user.
PLATFORM_ENABLE_ZALO_SIGNATURE_CHECK=true

# Telegram (Phase 8.x-T) — secondary channel.
# PLATFORM_TELEGRAM_BOT_TOKEN is Tổng Đài's own bot — deliberately NOT the
# TELEGRAM_BOT_TOKEN above, which is A Tiểu's order-notification bot. It is
# used to send replies back to the chat each message came from.
# TELEGRAM_WEBHOOK_SECRET is required: set it to the
# same value passed as setWebhook's secret_token so inbound requests can be
# verified via the X-Telegram-Bot-Api-Secret-Token header.
PLATFORM_TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/api/platform/webhook/telegram

# Bearer token for the admin API (/api/platform/merchants*: list, create,
# activate/suspend/close, issue merchant API keys). At least 32 characters,
# no spaces or commas, and not the same value as any other secret here;
# otherwise the admin API refuses every request (fail closed).
# Rotate it by changing this value and restarting the platform.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it as: Authorization: Bearer <token>
PLATFORM_ADMIN_API_TOKEN=

# Proxies allowed to set the client IP for rate limiting (Express "trust
# proxy" addresses). Leave empty unless a proxy on a known address forwards
# traffic to this server: with none, clients are identified by their own
# connection, so behind a local tunnel every client shares ONE rate-limit
# bucket (including Telegram's webhook deliveries).
# For cloudflared running on this same machine: loopback — but only once you
# have confirmed it forwards X-Forwarded-For with the real client IP as the
# LAST entry. A local proxy that passes the client's own X-Forwarded-For
# through unchanged (e.g. a raw TCP/SSH tunnel) would let clients pick their
# own IP. "true", hop counts, "*" and /0 subnets are refused.
PLATFORM_TRUST_PROXY=

PLATFORM_PORT=3901
PLATFORM_WEBHOOK_PATH=/platform/webhook

# "null" (default) or "anthropic" — same non-authoritative contract as the
# A Tiểu module's AI_PROVIDER; reuses ANTHROPIC_API_KEY/ANTHROPIC_MODEL above.
PLATFORM_AI_PROVIDER=null

PLATFORM_SQLITE_PATH=./data/platform.db

# Trial length is configuration, never a literal in code — see
# platform/domain/subscription.js. A plan row's own trial_days overrides this.
DEFAULT_TRIAL_DAYS=14

PLATFORM_RATE_LIMIT_WINDOW_MS=60000
PLATFORM_RATE_LIMIT_MAX=60

